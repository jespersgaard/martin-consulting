---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog" description="Praktiske indlæg om AI, Microsoft Copilot, Power Platform, automatisering og digitalisering i danske virksomheder – skrevet af IT-konsulent Martin Jespersgaard.">
  <Hero heading="Blog" lead="Praktiske indlæg om AI, Copilot, Power Platform og digitalisering." />
  <div class="container-x grid gap-5 py-14 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((p) => <PostCard post={p} />)}
  </div>
</BaseLayout>
