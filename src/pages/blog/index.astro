---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import PostList from '../../components/PostList.astro';
import TagCloud from '../../components/TagCloud.astro';
import { getPublishedPosts, getTagCounts } from '../../lib/blog';

const posts = await getPublishedPosts();
const tags = await getTagCounts();
---

<BaseLayout title="Blog" description="Praktiske indlæg om AI, Microsoft Copilot, Power Platform, automatisering og digitalisering i danske virksomheder – skrevet af IT-konsulent Martin Jespersgaard.">
  <Hero heading="Blog" lead="Praktiske indlæg om AI, Copilot, Power Platform og digitalisering." />
  <div class="container-x pt-10"><TagCloud tags={tags} total={posts.length} /></div>
  <PostList posts={posts} />
</BaseLayout>
