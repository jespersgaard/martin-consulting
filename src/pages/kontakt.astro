---
import { getEntry } from 'astro:content';
import PageView from '../components/PageView.astro';

const c = (await getEntry('pages', 'contact'))!.data;
const field = 'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-primary focus:outline-2 focus:outline-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white';
---

<PageView id="contact">
  <form id="contact-form" action="/send.php" method="post" class="mt-10 grid max-w-xl gap-4">
    <label class="text-sm font-medium">Navn
      <input class={field} name="name" type="text" required maxlength="100" autocomplete="name" />
    </label>
    <label class="text-sm font-medium">E-mail
      <input class={field} name="email" type="email" required autocomplete="email" />
    </label>
    <label class="text-sm font-medium">Besked
      <textarea class={field} name="message" required minlength="5" maxlength="5000" rows="6"></textarea>
    </label>
    <div class="hidden" aria-hidden="true">
      <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="flex items-center gap-4">
      <button type="submit" class="btn btn-primary">Send besked</button>
      <p id="form-status" role="status" class="text-sm"></p>
    </div>
  </form>
  {c.linkedin && <p class="mt-8 text-sm">Du finder mig også på <a href={c.linkedin} rel="me noopener" class="font-semibold text-primary">LinkedIn</a>.</p>}
</PageView>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const show = (ok: boolean, msg: string) => {
    status.textContent = msg;
    status.className = 'text-sm font-medium ' + (ok ? 'text-teal-600 dark:text-teal-400' : 'text-red-600 dark:text-red-400');
  };
  const q = new URLSearchParams(location.search).get('status');
  if (q) show(q === 'sendt', q === 'sendt' ? 'Tak for din besked. Jeg vender tilbage hurtigst muligt.' : 'Beskeden kunne ikke sendes. Prøv igen.');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    show(true, 'Sender…');
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json();
      show(data.ok, data.message);
      if (data.ok) form.reset();
    } catch {
      show(false, 'Beskeden kunne ikke sendes. Prøv igen senere.');
    } finally {
      btn.disabled = false;
    }
  });
</script>
