---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/seo';
import { tagSlug } from '../lib/blog';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { data } = post;
---

<article class="card flex h-full flex-col group-data-[view=list]/posts:flex-row group-data-[view=list]/posts:items-center group-data-[view=list]/posts:gap-5">
  {data.image && <img src={data.image} alt={data.imageAlt ?? ''} width="640" height="336" loading="lazy" decoding="async" class="mb-4 aspect-[1200/630] w-full rounded-lg object-cover group-data-[view=list]/posts:mb-0 group-data-[view=list]/posts:w-40 group-data-[view=list]/posts:shrink-0 sm:group-data-[view=list]/posts:w-56" />}
  <div class="flex flex-1 flex-col">
    <time datetime={data.pubDate.toISOString()} class="text-xs text-slate-500">{formatDate(data.pubDate)}</time>
    <h3 class="mt-2 text-lg font-semibold"><a href={`/blog/${post.id}/`} class="hover:text-primary">{data.title}</a></h3>
    <p class="mt-2 flex-1 text-sm">{data.description}</p>
    <div class="mt-4 flex flex-wrap gap-2">{data.tags.map((t) => <a href={`/blog/tag/${tagSlug(t)}/`} class="tag hover:bg-teal-100">{t}</a>)}</div>
  </div>
</article>
