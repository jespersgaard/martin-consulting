---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/seo';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { data } = post;
---

<article class="card flex h-full flex-col">
  {data.image && <img src={data.image} alt={data.imageAlt ?? ''} width="640" height="336" loading="lazy" decoding="async" class="mb-4 aspect-[1200/630] w-full rounded-lg object-cover" />}
  <time datetime={data.pubDate.toISOString()} class="text-xs text-slate-500">{formatDate(data.pubDate)}</time>
  <h3 class="mt-2 text-lg font-semibold"><a href={`/blog/${post.id}/`} class="hover:text-primary">{data.title}</a></h3>
  <p class="mt-2 flex-1 text-sm">{data.description}</p>
  <div class="mt-4 flex flex-wrap gap-2">{data.tags.map((t) => <span class="tag">{t}</span>)}</div>
</article>
