---
import { NAV, SITE } from '../lib/seo';
const path = Astro.url.pathname;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
  <div class="container-x flex h-16 items-center justify-between">
    <a href="/" class="font-semibold tracking-tight text-secondary dark:text-white">
      <span class="text-primary">M</span>artin Jespersgaard
    </a>
    <nav aria-label="Hovednavigation" class="hidden items-center gap-6 md:flex">
      {NAV.map((n) => (
        <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}
           class:list={['text-sm font-medium hover:text-primary', active(n.href) ? 'text-primary' : 'text-slate-600 dark:text-slate-300']}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <button id="theme-toggle" type="button" aria-label="Skift mellem lyst og mørkt tema" class="rounded-md p-2 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button id="menu-toggle" type="button" aria-label="Åbn menu" aria-expanded="false" aria-controls="mobile-menu" class="rounded-md p-2 text-slate-600 hover:bg-slate-100 md:hidden dark:text-slate-300 dark:hover:bg-slate-800">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" aria-label="Mobilnavigation" hidden class="border-t border-slate-200 md:hidden dark:border-slate-800">
    <div class="container-x flex flex-col py-2">
      {NAV.map((n) => <a href={n.href} class="py-2 text-sm font-medium">{n.label}</a>)}
    </div>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu!.hasAttribute('hidden');
    menu!.toggleAttribute('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
<!-- {SITE.name} -->
